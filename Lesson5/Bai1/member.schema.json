{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member API resource",
  "type": "object",
  "required": [
    "id",
    "fullName",
    "email",
    "joinedAt"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "joinedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
