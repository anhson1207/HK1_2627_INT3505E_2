{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Create Author request",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  },
  "additionalProperties": false
}
